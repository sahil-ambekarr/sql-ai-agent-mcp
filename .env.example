# --- Database backend -------------------------------------------------------
# sqlite (default, zero setup) or mssql (needs docker compose up, not verified locally)
DB_BACKEND=sqlite
SQLITE_PATH=data/sample.db

# SQL Server (only read when DB_BACKEND=mssql)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=SampleBusiness
MSSQL_USER=agent_reader
MSSQL_PASSWORD=change-me
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Used only by docker-compose.yml to start and seed the container
MSSQL_SA_PASSWORD=change-me-too

# --- Guardrails -------------------------------------------------------------
ROW_LIMIT_DEFAULT=100
ROW_LIMIT_MAX=500
QUERY_TIMEOUT_MS=5000
RESULT_MAX_BYTES=65536
MAX_QUERY_CHARS=8000
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Optional streamable HTTP transport (npm run server:http) ---------------
HTTP_PORT=4104

# --- Agent / LLM provider ---------------------------------------------------
# ollama (default) | claude (needs ANTHROPIC_API_KEY) | mock (tests and CI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=300000
AGENT_MAX_STEPS=6
# Pin "today" for reproducible answers to relative-date questions (YYYY-MM-DD)
AGENT_TODAY=
